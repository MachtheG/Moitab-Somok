# Copy to .env.local for local dev. In Vercel: Project → Settings → Environment Variables.

# Canonical site URL (no trailing slash). Used for metadata, sitemap, share links.
NEXT_PUBLIC_SITE_URL=https://example.com

# Where form submissions go: console (default, logs only) | resend | supabase
FORMS_ADAPTER=console

# Resend (FORMS_ADAPTER=resend)
RESEND_API_KEY=
FORMS_TO_EMAIL=
FORMS_FROM_EMAIL=

# Supabase (FORMS_ADAPTER=supabase). Table `submissions` (kind text, data jsonb, received_at timestamptz).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
